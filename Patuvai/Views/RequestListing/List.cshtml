@model IEnumerable<Patuvai.Models.RequestListing>

@{
    ViewData["Title"] = "Обяви за транспорт";
}

@functions {
    private string Truncate(string s, int max)
    {
        if (string.IsNullOrWhiteSpace(s)) return string.Empty;
        return s.Length <= max ? s : s.Substring(0, max) + "…";
    }
}

@if (Model == null || !Model.Any())
{
    <div>Няма налични обяви.</div>
}
else
{
    <div class="request-listings">
        @foreach (var requestListing in Model)
        {
            <div class="card mb-3 position-relative">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h5 class="card-title mb-1">@requestListing.TransportServiceType</h5>
                            <div class="text-muted small">
                                Дата на пътуване: @requestListing.RequestDate.ToString("d")
                            </div>
                        </div>
                        <div class="text-end small">
                            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Details","RequestListing", new { id = requestListing.Id })">Виж</a>
                        </div>
                    </div>

                    <hr />

                    <div class="mb-2">
                        <strong>От:</strong> @requestListing.FromCity?.Name
                        &nbsp;→&nbsp;
                        <strong>До:</strong> @requestListing.ToCity?.Name
                    </div>

                    @if (!string.IsNullOrWhiteSpace(requestListing.Description))
                    {
                        <p class="card-text text-truncate">@Truncate(requestListing.Description, 120)</p>
                    }

                    <div class="small text-muted">
						Публикувано от: @requestListing.Publisher?.FirstName @requestListing.Publisher?.LastName
                    </div>

                    <a href="@Url.Action("Details","RequestListing", new { id = requestListing.Id })" class="stretched-link" aria-label="Виж подробности"></a>
                </div>
            </div>
        }
    </div>
}
