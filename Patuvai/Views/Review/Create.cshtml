@model Patuvai.ViewModels.Review.ReviewFormViewModel

@{
    ViewData["Title"] = "Добавяне на ревю";
}

<h2>@ViewData["Title"]</h2>

<form asp-controller="Review" asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <input asp-for="DriverId" type="hidden"/>

    <div class="form-group mb-3">
        <label asp-for="Rating" class="form-label">Рейтинг</label>
        <input asp-for="Rating" class="form-control" type="number" min="1" max="5" />
        <span asp-validation-for="Rating" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Comment" class="form-label">Коментар</label>
        <textarea asp-for="Comment" class="form-control" maxlength="500" rows="4"></textarea>
        <span asp-validation-for="Comment" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Изпрати</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Отказ</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
